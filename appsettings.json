{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SocialMediaAppBackend"
    }
  },
  "AllowedHosts": "*",

  "OpenTelemetry": {
    "ServiceName": "SocialMediaAppBackend",
    "OtlpEndpoint": ""
  },

  "CorsOptions": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "JwtOptions": {
    "Issuer": "social-media-app-backend",
    "Audience": "social-media-app-frontend"
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=socialmediaapp;Username=postgres;Password=postgres"
  },

  "BlobStorage": {
    "BucketName": "",
    "Region": "auto",
    "AccessKey": "",
    "SecretKey": "",
    "ServiceUrl": "",
    "PublicBaseUrl": "",
    "ForcePathStyle": false
  }
}
